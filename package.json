{
  "name": "blast-radius",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jira release risk and Teamwork Graph context Forge skeleton",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "test": "node --test --test-isolation=none test/*.test.js",
    "build:demo": "node scripts/build-demo-data.mjs",
    "seed:plan": "node scripts/seed-demo-site.mjs --dry-run",
    "queries:plan": "node scripts/register-persisted-queries.mjs --dry-run",
    "lint:forge": "forge lint"
  },
  "dependencies": {
    "@forge/api": "latest",
    "@forge/bridge": "latest",
    "@forge/resolver": "latest",
    "@forge/react": "latest",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@forge/cli": "latest"
  }
}
